<div class="mb-6 flex flex-wrap items-end justify-between gap-3 border-b border-slate-200">
  <nav class="flex gap-1">
    <%= tab_link_to t(".overview", default: "Overview"),
          course_path(course),
          active: current_page?(course_path(course)) %>
    <% if can?(:manage, course) %>
      <%= tab_link_to t(".students", default: "Students"),
            course_students_path(course),
            active: current_page?(course_students_path(course)) %>
    <% end %>
  </nav>

  <% if local_assigns[:actions].present? %>
    <div class="flex shrink-0 items-center gap-2 pb-2"><%= actions %></div>
  <% end %>
</div>
