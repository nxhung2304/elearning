<%# locals: (course_progress:) %>

<% percentage = course_progress.progress_percentage.round %>
<% total_lessons = course_progress.enrollment.lesson_progresses.count %>

<div id="course_progress" class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="text-sm font-semibold uppercase tracking-wide text-slate-500"><%= t("courses.progress_bar.title") %></span>
      <% if course_progress.completed_at.present? %>
        <span class="inline-flex items-center rounded-full border border-current px-3 py-1 text-xs font-medium text-emerald-600">
          <%= t("courses.progress_bar.completed") %>
        </span>
      <% end %>
    </div>
    <span class="text-sm font-medium <%= percentage.positive? ? "text-emerald-600" : "text-slate-400" %>"><%= percentage %>%</span>
  </div>

  <div class="mt-3 h-2 w-full rounded-full bg-slate-100">
    <div class="h-2 rounded-full bg-emerald-600 transition-all" style="width: <%= percentage %>%"></div>
  </div>

  <p class="mt-2 text-xs text-slate-400">
    <%= t("courses.progress_bar.lessons_completed", completed: course_progress.completed_lessons_count, total: total_lessons) %>
  </p>
</div>
