<%# locals: (course:, sections:, enrolled:, can_manage:) %>
<div class="mt-8">
  <div class="mb-3 flex items-center justify-between">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500"><%= t("courses.curriculum.title") %></h2>
    <% if can_manage %>
      <%= link_to t("courses.show.manage_sections"), course_sections_path(course),
            class: "text-sm font-medium text-slate-500 transition-colors hover:text-slate-900" %>
    <% end %>
  </div>

  <% if sections.any? %>
    <div class="space-y-3">
      <% sections.each_with_index do |section, index| %>
        <% lessons = curriculum_lessons(section, can_manage: can_manage) %>
        <% duration = section_duration(lessons) %>
        <details <%= "open" if index.zero? %> class="group relative overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5">
          <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-4 pr-28 transition-colors hover:bg-slate-50">
            <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-medium text-slate-900"><%= section.title %></span>
              <span class="mt-0.5 block text-xs text-slate-400">
                <%= t("courses.curriculum.lessons_count", count: lessons.size) %><% if duration %> · <%= duration %><% end %>
              </span>
            </span>
          </summary>

          <% if can_manage %>
            <div class="absolute right-3 top-3.5 flex items-center gap-1 opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
              <%= link_to new_course_section_lesson_path(course, section),
                    class: button_classes(:icon_primary), title: t("courses.curriculum.add_lesson") do %>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span class="sr-only"><%= t("courses.curriculum.add_lesson") %></span>
              <% end %>
              <%= link_to edit_course_section_path(course, section),
                    class: button_classes(:icon), title: t("courses.curriculum.edit_section") do %>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                <span class="sr-only"><%= t("courses.curriculum.edit_section") %></span>
              <% end %>
              <%= button_to course_section_path(course, section),
                    method: :delete,
                    class: "#{button_classes(:icon_danger)} cursor-pointer",
                    form: { data: { turbo_confirm: t("courses.curriculum.delete_section_confirm") } },
                    title: t("courses.curriculum.delete_section") do %>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <span class="sr-only"><%= t("courses.curriculum.delete_section") %></span>
              <% end %>
            </div>
          <% end %>

          <div class="divide-y divide-slate-100 border-t border-slate-100">
            <% if lessons.any? %>
              <% lessons.each do |lesson| %>
                <%= render "lessons/row", lesson: lesson, course: course, section: section,
                      enrolled: enrolled, can_manage: can_manage %>
              <% end %>
            <% else %>
              <p class="px-4 py-4 text-sm text-slate-400"><%= t("courses.curriculum.empty_section") %></p>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <% if can_manage %>
      <%= link_to new_course_section_path(course),
            class: "mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-emerald-600 transition-colors hover:text-emerald-700" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <%= t("courses.curriculum.new_section") %>
      <% end %>
    <% end %>
  <% else %>
    <div class="rounded-2xl bg-white px-6 py-10 text-center shadow-sm ring-1 ring-slate-900/5">
      <% if can_manage %>
        <p class="text-sm text-slate-500"><%= t("courses.curriculum.empty_teacher") %></p>
        <%= link_to t("courses.curriculum.new_section"), new_course_section_path(course),
              class: "#{button_classes(:primary)} mt-4 inline-block" %>
      <% else %>
        <p class="text-sm text-slate-500"><%= t("courses.curriculum.empty_student") %></p>
      <% end %>
    </div>
  <% end %>
</div>
