<% add_breadcrumb "Courses", courses_path %>
<% add_breadcrumb @course.title %>
<section class="mx-auto max-w-3xl px-6 py-8">
  <div class="mb-6">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-slate-900 truncate"><%= @course.title %></h1>
      <%= render "shared/status_badge", status: @course.status %>
    </div>
    <p class="mt-1 text-sm text-slate-500"><%= @course.teacher.name %></p>
  </div>

  <% course_actions = capture do %>
    <%= render "enrollments/actions", course: @course, enrollment: @enrollment %>
    <% if can?(:manage, @course) %>
      <%= publish_toggle_link(@course) %>
      <% if @course.published? %>
        <%= link_to "Archive", archive_course_path,
              class: button_classes(:danger_outlined),
              data: { turbo_method: :patch, turbo_confirm: "Archive this course?" } %>
      <% end %>
    <% end %>
  <% end %>
  <%= render "courses/tabs", course: @course, actions: course_actions %>
  <dl class="divide-y divide-slate-200 rounded-xl border border-slate-200">
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:title) %></dt>
      <dd class="text-slate-900"><%= @course.title %></dd>
    </div>
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:description) %></dt>
      <dd class="text-slate-900"><%= @course.description %></dd>
    </div>
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:status) %></dt>
      <dd class="text-slate-900"><%= render "shared/status_badge", status: @course.status %></dd>
    </div>
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:level) %></dt>
      <dd class="text-slate-900"><%= @course.level %></dd>
    </div>
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:language) %></dt>
      <dd class="text-slate-900"><%= @course.language %></dd>
    </div>
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:price) %></dt>
      <dd class="text-slate-900"><%= @course.price %></dd>
    </div>
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:total_lessons) %></dt>
      <dd class="text-slate-900"><%= @course.total_lessons %></dd>
    </div>
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:category) %></dt>
      <dd class="text-slate-900"><%= @course.category %></dd>
    </div>
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:teacher) %></dt>
      <dd class="text-slate-900"><%= @course.teacher.name %></dd>
    </div>
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:created_at) %></dt>
      <dd class="text-slate-500 text-sm"><%= @course.created_at&.strftime("%Y-%m-%d %H:%M") %></dd>
    </div>
    <div class="flex px-4 py-3 gap-4">
      <dt class="w-1/3 font-medium text-slate-600"><%= Course.human_attribute_name(:updated_at) %></dt>
      <dd class="text-slate-500 text-sm"><%= @course.updated_at&.strftime("%Y-%m-%d %H:%M") %></dd>
    </div>
  </dl>
  <div class="mt-6 overflow-hidden rounded-xl border border-slate-200">
    <div class="flex items-center justify-between bg-slate-50 px-4 py-3 border-b border-slate-200">
      <h2 class="font-semibold text-slate-700 text-sm"><%= Section.model_name.human(count: 2) %></h2>
      <% if can?(:create, Section) %>
        <%= link_to t("helpers.links.new", model: Section.model_name.human, default: "New Section"),
              new_course_section_path(@course),
              class: "rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-emerald-700" %>
      <% end %>
    </div>
    <table class="w-full text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-4 py-3 text-left font-bold text-slate-600"><%= Section.human_attribute_name(:title) %></th>
          <th class="px-4 py-3 text-left font-bold text-slate-600"><%= Section.human_attribute_name(:position) %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% @course.sections.kept.each do |section| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3"><%= section.title %></td>
            <td class="px-4 py-3 text-slate-500"><%= section.position %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("helpers.links.show", default: "Show"),
                    course_section_path(@course, section),
                    class: "rounded-md border border-slate-300 px-4 py-1.5 text-xs font-medium text-slate-600 hover:border-slate-900 hover:text-slate-900 mr-2" %>
              <% if can?(:update, section) %>
                <%= link_to t("helpers.links.edit", default: "Edit"),
                      edit_course_section_path(@course, section),
                      class: "rounded-md border border-slate-300 px-4 py-1.5 text-xs font-medium text-slate-600 hover:border-slate-900 hover:text-slate-900 mr-2" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
