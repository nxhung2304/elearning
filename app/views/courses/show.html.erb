<% add_breadcrumb "Courses", courses_path %>
<% add_breadcrumb @course.title %>
<% can_manage = can?(:manage, @course) %>
<% enrolled = @enrollment.present? %>
<% all_lessons = @sections.flat_map { |section| curriculum_lessons(section, can_manage: can_manage) } %>
<% total_duration = section_duration(all_lessons) %>
<section class="mx-auto max-w-3xl px-6 py-8">
  <div class="mb-6">
    <div class="flex items-center gap-3">
      <h1 class="truncate text-2xl font-bold text-slate-900"><%= @course.title %></h1>
      <%= render "shared/status_badge", status: @course.status %>
    </div>
    <p class="mt-1 text-sm text-slate-500"><%= @course.teacher.name %></p>
  </div>

  <% course_actions = capture do %>
    <%= render "enrollments/actions", course: @course, enrollment: @enrollment %>
    <% if can_manage %>
      <%= publish_toggle_link(@course) %>
      <% if @course.published? %>
        <%= link_to "Archive", archive_course_path,
              class: button_classes(:danger_outlined),
              data: { turbo_method: :patch, turbo_confirm: "Archive this course?" } %>
      <% end %>
    <% end %>
  <% end %>
  <%= render "courses/tabs", course: @course, actions: course_actions %>

  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5">
    <% if @course.description.present? %>
      <p class="whitespace-pre-wrap text-sm leading-relaxed text-slate-700"><%= @course.description %></p>
    <% end %>
    <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <div class="flex items-center gap-1.5">
        <dt class="text-slate-400"><%= Course.human_attribute_name(:level) %>:</dt>
        <dd class="font-medium text-slate-700"><%= @course.level.humanize %></dd>
      </div>
      <div class="flex items-center gap-1.5">
        <dt class="text-slate-400"><%= Course.human_attribute_name(:language) %>:</dt>
        <dd class="font-medium text-slate-700"><%= @course.language.humanize %></dd>
      </div>
      <div class="flex items-center gap-1.5">
        <dt class="text-slate-400"><%= Course.human_attribute_name(:price) %>:</dt>
        <dd class="font-medium text-slate-700"><%= @course.price.positive? ? number_to_currency(@course.price) : t("courses.show.free") %></dd>
      </div>
      <div class="flex items-center gap-1.5">
        <dd class="font-medium text-slate-700"><%= t("courses.curriculum.lessons_count", count: all_lessons.size) %></dd>
      </div>
      <% if total_duration %>
        <div class="flex items-center gap-1.5">
          <dd class="font-medium text-slate-700"><%= total_duration %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%= render "courses/curriculum", course: @course, sections: @sections,
        enrolled: enrolled, can_manage: can_manage %>
</section>
