<%# locals: (lesson:, course:, section:, enrolled:, can_manage:) %>
<% locked = lesson_locked?(lesson, enrolled: enrolled, can_manage: can_manage) %>
<% row_content = capture do %>
  <span class="shrink-0 <%= locked ? "text-slate-300" : "text-slate-400" %>">
    <% if locked %>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
    <% else %>
      <%= lesson_type_icon(lesson) %>
    <% end %>
  </span>

  <span class="min-w-0 flex-1">
    <span class="block truncate text-sm font-medium <%= locked ? "text-slate-400" : "text-slate-900" %>"><%= lesson.title %></span>
    <span class="mt-0.5 block text-xs text-slate-400">
      <%= lesson.lesson_type.humanize %><% if lesson.duration_seconds.present? %> · <%= format_duration(lesson.duration_seconds) %><% end %>
    </span>
  </span>

  <span class="flex shrink-0 items-center gap-2">
    <% unless lesson.is_published %>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600"><%= t("lessons.row.draft") %></span>
    <% end %>
    <% if lesson.is_preview %>
      <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700"><%= t("lessons.row.preview") %></span>
    <% end %>
    <% if locked %>
      <span class="text-xs font-medium text-slate-400"><%= t("lessons.row.locked") %></span>
    <% end %>
  </span>
<% end %>

<div class="group flex items-center gap-3 px-4 py-3 transition-colors hover:bg-slate-50">
  <% if locked %>
    <div class="flex flex-1 items-center gap-3"><%= row_content %></div>
  <% else %>
    <%= link_to course_section_lesson_path(course, section, lesson),
          class: "flex flex-1 items-center gap-3 focus:outline-none focus-visible:ring-1 focus-visible:ring-emerald-600 rounded-lg" do %>
      <%= row_content %>
    <% end %>
  <% end %>

  <% if can_manage %>
    <div class="flex shrink-0 items-center gap-1 opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
      <%= link_to edit_course_section_lesson_path(course, section, lesson),
            class: button_classes(:icon_primary), title: t("lessons.row.edit") do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span class="sr-only"><%= t("lessons.row.edit") %></span>
      <% end %>
      <%= button_to course_section_lesson_path(course, section, lesson),
            method: :delete,
            class: "#{button_classes(:icon_danger)} cursor-pointer",
            form: { data: { turbo_confirm: t("lessons.row.delete_confirm") } },
            title: t("lessons.row.delete") do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <span class="sr-only"><%= t("lessons.row.delete") %></span>
      <% end %>
    </div>
  <% end %>
</div>
