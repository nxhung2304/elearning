<% add_breadcrumb @course.title, course_path(@course) %>
<% add_breadcrumb @section.title, course_section_path(@course, @section) %>
<% add_breadcrumb @lesson.title %>
<section class="mx-auto max-w-3xl px-6 py-8">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-medium text-slate-900"><%= Lesson.model_name.human %></h1>
    <%= link_to course_section_lessons_path(@course, @section),
          class: "inline-flex items-center gap-1 rounded-full px-3 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-900/5" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      <%= t("helpers.links.back", default: "Back") %>
    <% end %>
  </div>

  <dl class="divide-y divide-slate-100 rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5">
    <div class="flex px-5 py-4 gap-4">
      <dt class="w-1/3 text-sm font-medium text-slate-500"><%= Lesson.human_attribute_name(:title) %></dt>
      <dd class="text-sm font-semibold text-slate-900"><%= @lesson.title %></dd>
    </div>
    <div class="flex px-5 py-4 gap-4">
      <dt class="w-1/3 text-sm font-medium text-slate-500"><%= Lesson.human_attribute_name(:lesson_type) %></dt>
      <dd class="text-sm text-slate-700"><%= @lesson.lesson_type %></dd>
    </div>
    <div class="flex px-5 py-4 gap-4">
      <dt class="w-1/3 text-sm font-medium text-slate-500"><%= Lesson.human_attribute_name(:position) %></dt>
      <dd class="text-sm text-slate-700"><%= @lesson.position %></dd>
    </div>
    <div class="flex px-5 py-4 gap-4">
      <dt class="w-1/3 text-sm font-medium text-slate-500"><%= Lesson.human_attribute_name(:duration_seconds) %></dt>
      <dd class="text-sm text-slate-700"><%= @lesson.duration_seconds %></dd>
    </div>
    <div class="flex px-5 py-4 gap-4">
      <dt class="w-1/3 text-sm font-medium text-slate-500"><%= Lesson.human_attribute_name(:content) %></dt>
      <dd class="text-sm text-slate-700 whitespace-pre-wrap"><%= @lesson.content %></dd>
    </div>
    <div class="flex px-5 py-4 gap-4">
      <dt class="w-1/3 text-sm font-medium text-slate-500"><%= Lesson.human_attribute_name(:is_preview) %></dt>
      <dd class="text-sm text-slate-700"><%= @lesson.is_preview ? t("shared.yes") : t("shared.no") %></dd>
    </div>
    <div class="flex px-5 py-4 gap-4">
      <dt class="w-1/3 text-sm font-medium text-slate-500"><%= Lesson.human_attribute_name(:is_published) %></dt>
      <dd class="text-sm text-slate-700"><%= @lesson.is_published ? t("shared.yes") : t("shared.no") %></dd>
    </div>
    <div class="flex px-5 py-4 gap-4">
      <dt class="w-1/3 text-sm font-medium text-slate-500"><%= Lesson.human_attribute_name(:published_at) %></dt>
      <dd class="text-sm text-slate-700"><%= l(@lesson.published_at) if @lesson.published_at.present? %></dd>
    </div>
    <div class="flex px-5 py-4 gap-4">
      <dt class="w-1/3 text-sm font-medium text-slate-500"><%= Lesson.human_attribute_name(:created_at) %></dt>
      <dd class="text-sm text-slate-700"><%= l(@lesson.created_at) %></dd>
    </div>
    <div class="flex px-5 py-4 gap-4">
      <dt class="w-1/3 text-sm font-medium text-slate-500"><%= Lesson.human_attribute_name(:updated_at) %></dt>
      <dd class="text-sm text-slate-700"><%= l(@lesson.updated_at) %></dd>
    </div>
  </dl>

  <% if @lesson_resources.any? %>
    <div class="mt-8">
      <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-slate-500"><%= t(".attachments") %></h2>
      <ul class="divide-y divide-slate-100 rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5">
        <% @lesson_resources.each do |resource| %>
          <li class="flex items-center justify-between px-5 py-3">
            <span class="text-sm text-slate-900"><%= resource.file_name %></span>
            <div class="flex items-center gap-1">
              <%= link_to rails_blob_path(resource.file, disposition: "attachment"),
                    class: button_classes(:icon_primary),
                    title: t("helpers.links.download") do %>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
                </svg>
                <span class="sr-only"><%= t("helpers.links.download") %></span>
              <% end %>
              <%= button_to course_section_lesson_lesson_resource_path(@course, @section, @lesson, resource),
                    method: :delete,
                    data: { turbo_confirm: t(".confirm_delete_attachment") },
                    class: "#{button_classes(:icon_danger)} cursor-pointer",
                    title: t("helpers.links.delete") do %>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <span class="sr-only"><%= t("helpers.links.delete") %></span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-8">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-slate-500"><%= t(".upload_attachment") %></h2>
    <%= form_with url: course_section_lesson_lesson_resources_path(@course, @section, @lesson),
          multipart: true, class: "flex items-end gap-3 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-900/5",
          data: { controller: "file-upload" } do |f| %>
      <div class="flex-1">
        <%= label_tag :file_name, t(".display_name"), class: "mb-1 block text-xs font-medium text-slate-500" %>
        <%= text_field_tag :file_name, nil, placeholder: t(".display_name_placeholder"),
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600" %>
      </div>
      <div class="flex-1">
        <%= label_tag :file, t(".file"), class: "mb-1 flex items-center gap-1 text-xs font-medium text-slate-500" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 10-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
          </svg>
          <%= t(".file") %>
        <% end %>
        <%= file_field_tag :file, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-500 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600 cursor-pointer", data: { file_upload_target: "input", action: "change->file-upload#toggle" } %>
      </div>
      <%= button_tag type: "button",
            class: "#{button_classes(:icon_danger)} cursor-pointer hidden",
            data: { file_upload_target: "button", action: "click->file-upload#clear" },
            title: t("helpers.links.cancel") do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span class="sr-only"><%= t("helpers.links.cancel") %></span>
      <% end %>
      <%= button_tag type: "submit",
            class: "#{button_classes(:icon_filled)} cursor-pointer hidden",
            data: { file_upload_target: "button" },
            title: t(".upload") do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v9m0-9l4 4m-4-4L8 8" />
        </svg>
        <span class="sr-only"><%= t(".upload") %></span>
      <% end %>
    <% end %>
  </div>
</section>
